---
// Image grid; clicking an image opens it in a lightbox popup with its caption.
interface Props {
  images: { src: string; alt: string; caption?: string }[];
}
const { images } = Astro.props;
---

<div class="gallery">
  {
    images.map((img) => (
      <button class="gallery__item" data-lightbox={img.src} data-caption={img.caption ?? img.alt}>
        <img src={img.src} alt={img.alt} loading="lazy" />
      </button>
    ))
  }
</div>

<dialog class="lightbox" id="lightbox">
  <button class="lightbox__close" aria-label="Close image">×</button>
  <img src="" alt="" />
  <p class="lightbox__caption"></p>
</dialog>

<script>
  const lightbox = document.getElementById('lightbox') as HTMLDialogElement;
  const img = lightbox.querySelector('img')!;
  const caption = lightbox.querySelector('.lightbox__caption')!;
  document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((btn) =>
    btn.addEventListener('click', () => {
      img.src = btn.dataset.lightbox!;
      img.alt = btn.dataset.caption!;
      caption.textContent = btn.dataset.caption!;
      lightbox.showModal();
    })
  );
  lightbox.querySelector('.lightbox__close')!.addEventListener('click', () => lightbox.close());
  lightbox.addEventListener('click', (e) => e.target === lightbox && lightbox.close());
</script>

<style>
  .gallery { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .gallery__item { padding: 0; border: 0; background: none; cursor: zoom-in; border-radius: var(--radius); overflow: hidden; }
  .lightbox { border: 0; padding: 0; background: transparent; max-width: 92vw; }
  .lightbox::backdrop { background: rgba(0, 0, 0, 0.85); }
  .lightbox img { max-height: 80vh; border-radius: 8px; }
  .lightbox__caption { color: #fff; text-align: center; }
  .lightbox__close { position: fixed; top: 16px; right: 20px; color: #fff; background: none; border: 0; font-size: 2rem; cursor: pointer; }
</style>
