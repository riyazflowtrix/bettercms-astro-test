---
import BaseLayout from '../layouts/BaseLayout.astro';
import Modal from '../components/Modal.astro';

const offices = [
  { city: 'Bengaluru', address: '42 MG Road, Bengaluru 560001, India', phone: '+91 80 1234 5678' },
  { city: 'London', address: '10 Fleet Street, London EC4Y 1AA, UK', phone: '+44 20 1234 5678' },
];
---

<BaseLayout title="Contact" description="Get in touch with the Lumen team.">
  <section class="section">
    <div class="container contact">
      <div>
        <h1>Let's talk</h1>
        <p>Tell us about your site and we'll get back to you within one business day.</p>
        {
          offices.map((o) => (
            <div class="office">
              <h3>{o.city}</h3>
              <p>{o.address}<br /><a href={`tel:${o.phone.replace(/\s/g, '')}`}>{o.phone}</a></p>
            </div>
          ))
        }
        <p>Email: <a href="mailto:hello@lumen-demo.example.com">hello@lumen-demo.example.com</a></p>
      </div>

      <form class="card contact__form" id="contact-form" action="#" method="post">
        <div>
          <label for="name">Full name</label>
          <input id="name" name="name" required placeholder="Jane Doe" />
        </div>
        <div>
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required placeholder="jane@company.com" />
        </div>
        <div>
          <label for="topic">Topic</label>
          <select id="topic" name="topic">
            <option>Sales</option>
            <option>Support</option>
            <option>Partnerships</option>
          </select>
        </div>
        <div>
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" placeholder="How can we help?"></textarea>
        </div>
        <label class="checkbox"><input type="checkbox" required /> I agree to the <a href="/privacy">privacy policy</a>.</label>
        <button class="btn btn--primary" type="submit">Send message</button>
      </form>
    </div>
  </section>

  <Modal id="contact-success" title="Message sent 🎉">
    <p>Thanks for reaching out. A real person will reply within one business day.</p>
  </Modal>
</BaseLayout>

<script>
  document.getElementById('contact-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    (e.target as HTMLFormElement).reset();
    (document.getElementById('contact-success') as HTMLDialogElement).showModal();
  });
</script>

<style>
  .contact { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 48px; }
  .contact__form { display: grid; gap: 16px; }
  .office h3 { margin-bottom: 4px; }
  .checkbox { display: flex; gap: 8px; align-items: center; font-weight: 400; }
  .checkbox input { width: auto; }
</style>
